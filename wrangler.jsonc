{
  "name": "campus-market",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campus-market-db",
      "database_id": "PUT_YOUR_D1_DATABASE_ID_HERE"
    }
  ],

  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "campus-market-images"
    }
  ]
}
